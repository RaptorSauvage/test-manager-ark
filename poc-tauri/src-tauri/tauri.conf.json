{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tauri-poc-shell",
  "version": "0.1.0",
  "identifier": "com.bober.tauripoc",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Tauri PoC - Bober Server Manager",
        "width": 900,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "externalBin": ["binaries/sidecar-bin", "binaries/bot-bin"],
    "targets": ["deb"],
    "icon": ["icons/icon.png"]
  }
}
